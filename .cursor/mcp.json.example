{
  "mcpServers": {
    "app-store-connect": {
      "command": "node",
      "args": [
        "${workspaceFolder}/tools/app-store-connect-mcp/node_modules/appstore-connect-mcp-server/dist/src/index.js"
      ],
      "env": {
        "APP_STORE_CONNECT_KEY_ID": "YOUR_KEY_ID",
        "APP_STORE_CONNECT_ISSUER_ID": "YOUR_ISSUER_ID",
        "APP_STORE_CONNECT_P8_PATH": "/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
      }
    }
  }
}
